# Prod environment — real devices
ENV_LABEL="prod-real-devices"
K8S_CONTEXT="prod"
NAMESPACE="prod"
LOCAL_PORT="9203"
NO_AUTH=true                 # prod ES has no authentication
SECRET=""                    # unused when NO_AUTH=true
INDEX_PREFIX="zen"
TENANT_IDS=""                # not used in queries (wildcard index pattern spans all tenants)
